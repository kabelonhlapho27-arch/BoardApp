@model BoardApp.Models.Board
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width"/>
        <title>Add a Board</title>
        <link rel="stylesheet" href="/css/styles.css"/>
    </head>
    <body>
        <form asp-action="AddBoard" method="post">
            <div asp-validation-summary="All"></div>
        <p>
            <label asp-for="BoardCode">Board Code:</label>
            <input asp-for="BoardCode"/>
            <span asp-validation-for="BoardCode"></span>
        </p>

        <p>
            <label asp-for="Make">Manufacturer:</label>
            <input asp-for="Make" /> 
            <span asp-validation-for="Make"></span>
        </p>

        <p>
            <label asp-for="Model">Model:</label>
            <input asp-for="Model" />
            <span asp-validation-for="Model"></span>
        </p>

        <p>
            <label asp-for="FlashKb">Flash size in KB:</label>
            <input asp-for="FlashKb" /> 
            <span asp-validation-for="FlashKb"></span>
        </p>

        <p>
            <label asp-for="Price">Price:</label>
            <input asp-for="Price" />   
            <span asp-validation-for="Price"></span>
        </p>
        <button type="submit">Add new board</button>

        </form>
    </body>
</html>
